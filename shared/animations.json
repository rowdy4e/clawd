{
  "_note": "Declarative animation library shared between Cinnamon applet (JS) and cinnamon-screensaver widget (Python). Interpreter lives in each runtime; this file is data only.",

  "_dsl": {
    "primitives": {
      "tween":      "{tween: KEY, to: VALUE, ms: N, ease: NAME?}",
      "tween_many": "{tween_many: {K1: V1, K2: V2, ...}, ms: N, ease: NAME?}  -- parallel tweens, single onComplete",
      "delay":      "{delay: N}                                  -- pause N ms",
      "set":        "{set: {KEY: VALUE, ...}}                    -- instantly assign state keys",
      "repeat":     "{repeat: N, body: [step, ...]}              -- run body N times",
      "sequence":   "{sequence: {tween: KEY, ms: N, ease: NAME?, values: [v|step,...]}} -- chain of tweens on same key",
      "parallel":   "{parallel: [[step,...], [step,...]]}        -- run scripts in parallel, await longest"
    },
    "value_generators": {
      "literal":      "number, string, true, false",
      "random_pick":  "{random_pick: [a, b, c]}                  -- choose one option uniformly",
      "random_from":  "{random_from: LIST_NAME}                  -- choose from runtime-supplied named list",
      "random_range": "{random_range: [min, max]}                -- uniform float in range",
      "iter_pick":    "{iter_pick: [a, b]}                       -- inside repeat: a on even iterations, b on odd",
      "ref":          "{ref: KEY}                                -- value of another key being set in the same `set` block"
    },
    "scaling": {
      "intensity_y": "body_y values are multiplied by the runtime's intensity_y (panel ~0.6, lockscreen 1.0)"
    }
  },

  "easings": [
    "linear",
    "ease_out_quad",
    "ease_in_quad",
    "ease_in_out_quad",
    "ease_in_out_cubic",
    "ease_out_back",
    "ease_out_bounce"
  ],

  "default_state": {
    "body_x": 0, "body_y": 0,
    "scale_x": 1.0, "scale_y": 1.0,
    "tilt": 0,
    "eye_open": 1.0, "eye_state": "normal",
    "mouth_visible": 0, "mouth_shape": 0,
    "walk_phase": 0, "walking": 0,
    "form_a": "clawd", "form_b": "clawd", "morph_t": 0,
    "excited": 0,
    "rainbow_active": 0, "rainbow_phase": 0
  },

  "intensity_y_keys": ["body_y"],

  "tags": {
    "_note": "Per-animation labels. Pickers filter by tag (e.g. easter_egg is excluded from the normal random pool and rolled separately at low probability).",
    "grow": ["easter_egg"]
  },

  "animations": {
    "bounce": [
      {"tween": "body_y", "to": -10, "ms": 180, "ease": "ease_out_quad"},
      {"tween": "body_y", "to": 0,   "ms": 400, "ease": "ease_out_bounce"}
    ],

    "wiggle": [
      {"tween": "tilt", "to": -14, "ms": 100, "ease": "linear"},
      {"tween": "tilt", "to":  14, "ms": 120, "ease": "linear"},
      {"tween": "tilt", "to":  -8, "ms": 100, "ease": "linear"},
      {"tween": "tilt", "to":   0, "ms": 120, "ease": "linear"}
    ],

    "squish": [
      {"tween_many": {"scale_x": 1.15, "scale_y": 0.80}, "ms": 120, "ease": "ease_out_quad"},
      {"tween_many": {"scale_x": 0.90, "scale_y": 1.12}, "ms": 180, "ease": "ease_out_quad"},
      {"tween_many": {"scale_x": 1.0,  "scale_y": 1.0},  "ms": 240, "ease": "ease_out_bounce"}
    ],

    "spin": [
      {"tween": "tilt", "to": 360, "ms": 700, "ease": "ease_in_out_cubic"},
      {"set": {"tilt": 0}}
    ],

    "shake": {
      "sequence": {
        "tween": "body_x",
        "ms": 60,
        "ease": "linear",
        "values": [5, -5, 4, -4, 2, -2, 0]
      }
    },

    "tilt": [
      {"tween": "tilt", "to": {"random_pick": [-18, 18]}, "ms": 250, "ease": "ease_out_quad"},
      {"delay": 450},
      {"tween": "tilt", "to": 0, "ms": 350, "ease": "ease_out_back"}
    ],

    "walk": [
      {"set": {"walking": 1, "walk_phase": 0}},
      {"repeat": 4, "body": [
        {"tween_many": {
            "walk_phase": {"iter_pick": [0.99, 0]},
            "body_y":     {"iter_pick": [-3, 0]}
          },
          "ms": 220, "ease": "ease_in_out_quad"
        }
      ]},
      {"tween": "body_y", "to": 0, "ms": 150, "ease": "linear"},
      {"set": {"walking": 0, "walk_phase": 0}}
    ],

    "wink": [
      {"set": {"eye_state": {"random_pick": ["wink-l", "wink-r"]}}},
      {"delay": 450},
      {"set": {"eye_state": "normal"}}
    ],

    "yawn": [
      {"set": {"eye_state": "sleepy", "mouth_shape": 1}},
      {"tween": "mouth_visible", "to": 1, "ms": 250, "ease": "ease_out_quad"},
      {"delay": 900},
      {"tween": "mouth_visible", "to": 0, "ms": 300, "ease": "ease_in_quad"},
      {"set": {"eye_state": "normal", "mouth_shape": 0}}
    ],

    "lookAround": [
      {"tween": "tilt", "to": -8, "ms": 250, "ease": "ease_out_quad"},
      {"delay": 220},
      {"tween": "tilt", "to":  8, "ms": 350, "ease": "ease_in_out_quad"},
      {"delay": 220},
      {"tween": "tilt", "to":  0, "ms": 250, "ease": "ease_out_quad"}
    ],

    "morph": [
      {"set": {"form_a": "clawd",
               "form_b": {"random_from": "MORPH_TARGETS"},
               "morph_t": 0}},
      {"tween": "morph_t", "to": 1, "ms": 600, "ease": "ease_in_out_quad"},
      {"delay": 1400},
      {"tween": "morph_t", "to": 0, "ms": 500, "ease": "ease_in_out_quad"},
      {"set": {"form_b": "clawd"}}
    ],

    "glitch": [
      {"repeat": 6, "body": [
        {"set": {
            "form_a": {"random_from": "MORPH_TARGETS"},
            "form_b": {"ref": "form_a"},
            "morph_t": 0,
            "body_x": {"random_range": [-3, 3]}
          }
        },
        {"delay": 70}
      ]},
      {"set": {"form_a": "clawd", "form_b": "clawd", "morph_t": 0, "body_x": 0}}
    ],

    "excited": [
      {"parallel": [
        [{"tween": "excited", "to": 1, "ms": 100}],
        [{"sequence": {"tween": "body_x", "ms": 50, "ease": "linear",
                       "values": [3, -3, 3, -3, 2, -2, 0]}}]
      ]},
      {"tween": "excited", "to": 0, "ms": 300}
    ],

    "grow": [
      {"tween_many": {"scale_x": 3.0, "scale_y": 3.0}, "ms": 500, "ease": "ease_out_back"},
      {"delay": 800},
      {"tween_many": {"scale_x": 1.0, "scale_y": 1.0}, "ms": 500, "ease": "ease_out_bounce"}
    ],

    "rainbow": [
      {"set": {"rainbow_active": 1, "rainbow_phase": 0}},
      {"repeat": 2, "body": [
        {"set": {"rainbow_phase": 0}},
        {"tween": "rainbow_phase", "to": 1, "ms": 1200, "ease": "linear"}
      ]},
      {"tween": "rainbow_active", "to": 0, "ms": 300, "ease": "linear"}
    ]
  }
}
